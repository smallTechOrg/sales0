# sales0 configuration. Copy to .env (gitignored) and fill in the key.
# Every variable is read by sales0.config.Settings (prefix SALES0_). Blank = use the default.

# --- LLM (Anthropic Claude Haiku only) ---
# Required. Your Anthropic API key. Never commit it.
SALES0_ANTHROPIC_API_KEY=
# Optional. Only if your key is NOT scoped to a workspace: the Anthropic workspace id (wrkspc_...),
# sent as the anthropic-workspace-id header. Leave blank for a workspace-scoped key.
SALES0_ANTHROPIC_WORKSPACE_ID=
# Model id (Haiku only by constraint). Default: claude-haiku-5-5
SALES0_LLM_MODEL=claude-haiku-5-5
# Max output tokens per triage call. Default: 900
SALES0_LLM_MAX_OUTPUT_TOKENS=900
# Per-request timeout in seconds. Default: 30
SALES0_LLM_TIMEOUT_S=30
# Retries on 429 / 5xx / timeouts (exponential backoff with jitter, base 1s). Default: 3
SALES0_LLM_MAX_RETRIES=3
# USD per 1M input tokens. Default: 1.00 (confirm against current Anthropic pricing)
SALES0_LLM_PRICE_INPUT_USD_PER_MTOK=1.00
# USD per 1M output tokens. Default: 5.00 (confirm against current Anthropic pricing)
SALES0_LLM_PRICE_OUTPUT_USD_PER_MTOK=5.00

# --- Server ---
# Bind host. Phase 1 refuses anything other than 127.0.0.1 / localhost. Default: 127.0.0.1
SALES0_HOST=127.0.0.1
# Bind port (deliberately not a framework default). Default: 8765
SALES0_PORT=8765

# --- Storage ---
# Runtime dir (DB, browser profiles, logs), relative to the repo root. Default: data
SALES0_DATA_DIR=data
# SQLAlchemy URL. Relative sqlite paths resolve against the repo root. Default: sqlite:///data/sales0.db
SALES0_DATABASE_URL=sqlite:///data/sales0.db
# Optional. Tests default to a fresh sqlite:///<pytest tmp>/test.db per test, never the dev DB.
SALES0_TEST_DATABASE_URL=

# --- Time ---
# "Today" / "this month" boundaries and display. Default: Asia/Kolkata
SALES0_TIMEZONE=Asia/Kolkata

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR. Default: INFO
SALES0_LOG_LEVEL=INFO
# json | console. Default: json
SALES0_LOG_FORMAT=json
# Optional JSONL file path (relative paths resolve against the repo root), e.g. data/logs/sales0.jsonl
SALES0_LOG_FILE=

# --- LinkedIn ---
# live | fixture (fixture = offline fake LinkedIn served by this app). Default: live
SALES0_LINKEDIN_MODE=live
# Run live scrapes headless? Default false (headed = lower detection risk). Fixture mode is always headless.
SALES0_LINKEDIN_HEADLESS=false
# Seconds Connect waits for you to finish logging in. Default: 300
SALES0_LINKEDIN_CONNECT_TIMEOUT_S=300

# --- Scrape safety caps and pacing ---
# Max keywords searched per run. Default: 10
SALES0_SCRAPE_MAX_KEYWORDS_PER_RUN=10
# Max posts collected per keyword. Default: 15
SALES0_SCRAPE_MAX_POSTS_PER_KEYWORD=15
# Max posts seen per local day across runs. Default: 150
SALES0_SCRAPE_MAX_POSTS_PER_DAY=150
# Max runs started per local day (aborted runs count). Default: 3
SALES0_SCRAPE_MAX_RUNS_PER_DAY=3
# Random delay between page actions, seconds. Defaults: 3 / 9
SALES0_SCRAPE_DELAY_MIN_S=3
SALES0_SCRAPE_DELAY_MAX_S=9
# Random pause between keywords, seconds. Defaults: 20 / 60
SALES0_SCRAPE_KEYWORD_PAUSE_MIN_S=20
SALES0_SCRAPE_KEYWORD_PAUSE_MAX_S=60
# Max scrolls per keyword results page. Default: 4
SALES0_SCRAPE_MAX_SCROLLS=4
# past-24h | past-week | past-month. Default: past-week
SALES0_SCRAPE_DATE_FILTER=past-week

# --- Triage ---
# Few-shot examples per triage call. Default: 6
SALES0_FEWSHOT_MAX_EXAMPLES=6
# Truncation per few-shot example, characters. Default: 600
SALES0_FEWSHOT_TEXT_CHARS=600
# Truncation of the enquiry text sent to the LLM, characters. Default: 4000
SALES0_TRIAGE_MAX_INPUT_CHARS=4000
