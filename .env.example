# sales0 configuration. Copy to .env (gitignored) and fill in the key.
# Every variable is read by sales0.config.Settings (prefix SALES0_). Blank = use the default.

# --- LLM (Anthropic Claude Haiku only) ---
# Required. Your Anthropic API key. Never commit it.
SALES0_ANTHROPIC_API_KEY=
# Optional. Only if your key is NOT scoped to a workspace: the Anthropic workspace id (wrkspc_...),
# sent as the anthropic-workspace-id header. Leave blank for a workspace-scoped key.
SALES0_ANTHROPIC_WORKSPACE_ID=
# Model id (Haiku only by constraint). Default: claude-haiku-5-5
SALES0_LLM_MODEL=claude-haiku-5-5
# Max output tokens per triage call. Default: 900
SALES0_LLM_MAX_OUTPUT_TOKENS=900
# Per-request timeout in seconds. Default: 30
SALES0_LLM_TIMEOUT_S=30.0
# Retries on 429 / 5xx / timeouts (exponential backoff with jitter, base 1s). Default: 3
SALES0_LLM_MAX_RETRIES=3
# Token prices used for the cost view, USD per 1M tokens.
# claude-haiku-5-5: $0.10 in / $0.50 out per MTok for prompts up to 100K tokens
# USD per 1M input tokens. Default: 0.10
SALES0_LLM_PRICE_INPUT_USD_PER_MTOK=0.10
# USD per 1M output tokens. Default: 0.50
SALES0_LLM_PRICE_OUTPUT_USD_PER_MTOK=0.50

# --- Server ---
# Bind host. Phase 1 refuses anything other than 127.0.0.1 / localhost. Default: 127.0.0.1
SALES0_HOST=127.0.0.1
# Bind port (deliberately not a framework default). Default: 8765
SALES0_PORT=8765

# --- Storage ---
# Runtime dir (DB, browser profiles, logs), relative to the repo root. Default: data
SALES0_DATA_DIR=data
# Skip the one-process-per-data-dir lock (<data_dir>/.sales0.lock). Unsupported; leave off.
SALES0_ALLOW_MULTI_PROCESS=false
# SQLAlchemy URL. Relative sqlite paths resolve against the repo root. Default: sqlite:///data/sales0.db
SALES0_DATABASE_URL=sqlite:///data/sales0.db
# Optional. Tests default to a fresh sqlite:///<pytest tmp>/test.db per test, never the dev DB.
SALES0_TEST_DATABASE_URL=

# --- Google / Gmail (see docs/gmail-setup.md) ---
# OAuth Desktop-client JSON downloaded from Google Cloud Console. Default: data/google_client_secret.json
SALES0_GOOGLE_CLIENT_SECRET_PATH=data/google_client_secret.json
# Where `google-auth` stores the token (chmod 600, gitignored under data/). Default: data/google_token.json
SALES0_GOOGLE_TOKEN_PATH=data/google_token.json

# --- Time ---
# "Today" / "this month" boundaries and display. Default: Asia/Kolkata
SALES0_TIMEZONE=Asia/Kolkata

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR. Default: INFO
SALES0_LOG_LEVEL=INFO
# json | console. Default: json
SALES0_LOG_FORMAT=json
# Optional JSONL file path (relative paths resolve against the repo root), e.g. data/logs/sales0.jsonl
SALES0_LOG_FILE=

# --- LinkedIn ---
# live | fixture (fixture = offline fake LinkedIn served by this app). Default: live
SALES0_LINKEDIN_MODE=live
# Seconds Connect waits for you to finish logging in. Default: 300
SALES0_LINKEDIN_CONNECT_TIMEOUT_S=300
# Which browser sales0 drives: auto | chrome | chromium. Default: auto
#   auto     = your installed Google Chrome (on sales0's own profile), else the built-in Chromium
#   chrome   = Google Chrome only (an error if it is not installed)
#   chromium = the built-in Chromium only (tests; needs `uv run playwright install chromium`)
# Connect always opens a visible window; checks and runs are always hidden (headless).
SALES0_LINKEDIN_BROWSER_CHANNEL=auto
# Minutes Run now stays refused after a run stopped on a rate limit or captcha. 0 = off. Default: 60
SALES0_SAFETY_COOLDOWN_MIN=60
# Minutes Run now stays refused after a run stopped on a checkpoint or logout. 0 = off. Default: 15
SALES0_SAFETY_COOLDOWN_CHECKPOINT_MIN=15

# --- Scrape safety caps and pacing ---
# Max keywords searched per run. Default: 40
SALES0_SCRAPE_MAX_KEYWORDS_PER_RUN=40
# Max posts scanned per keyword across all search passes. Default: 80
SALES0_SCRAPE_MAX_POSTS_PER_KEYWORD=80
# Max posts scanned per local day across runs. Default: 2000
SALES0_SCRAPE_MAX_POSTS_PER_DAY=2000
# Max discovery runs started per account per local day (aborted runs count). Default: 2
SALES0_SCRAPE_MAX_RUNS_PER_DAY=2
# LinkedIn page loads per account per day (search passes, profile visits, permalink pages); a run ends early when used up
SALES0_SCRAPE_MAX_PAGELOADS_PER_DAY=600
# consecutive page errors that stop a run as rate-limited (starts the cool-down)
SALES0_SCRAPE_MAX_CONSECUTIVE_ERRORS=3
# Random delay between page actions, seconds. Defaults: 3 / 9
SALES0_SCRAPE_DELAY_MIN_S=3
SALES0_SCRAPE_DELAY_MAX_S=9
# Random pause between keywords, seconds. Defaults: 20 / 60
SALES0_SCRAPE_KEYWORD_PAUSE_MIN_S=20
SALES0_SCRAPE_KEYWORD_PAUSE_MAX_S=60
# Max scrolls per search pass. Default: 20
SALES0_SCRAPE_MAX_SCROLLS=20
# For relevant posts LinkedIn shows without a link: max posts per keyword whose "…" menu sales0 opens to
# press "Copy link to post" (slowly, one safety check per step). The copy is intercepted inside
# the page, so your computer's clipboard is never touched. 0 = off (cards then link to the
# author's profile). Default: 15
SALES0_SCRAPE_PERMALINK_MAX_PER_KEYWORD=15
# Consecutive scrolls without new cards that end a search pass ("no growth"). Default: 2
SALES0_SCRAPE_NO_GROWTH_SCROLLS=2
# latest (newest posts first) | relevance (LinkedIn's own ranking). Default: latest
SALES0_SCRAPE_SORT=latest
# Comma list of past-24h | past-week | past-month: one search pass each, in order; the next pass
# runs only while the keyword's post cap is not reached. Default: past-week,past-month
# The older single filter below is still read as a one-item list when ..._FILTERS is unset.
SALES0_SCRAPE_DATE_FILTERS=past-week,past-month
# SALES0_SCRAPE_DATE_FILTER=
# Max "see more" clicks per keyword (truncated cards only). Default: 40
# Phase 1.5: per-phrase search variants (other sort, quote-wrapped, #hashtag, urgent/requirement/enquiry
# suffixes, other date filters) as extra passes in a daily rotation (live mode only); passes per phrase capped.
SALES0_SCRAPE_VARIANTS=true
SALES0_SCRAPE_MAX_PASSES_PER_KEYWORD=3
SALES0_SCRAPE_EXPAND_MAX_PER_KEYWORD=40

# --- Triage ---
# Few-shot examples per triage call. Default: 6
SALES0_FEWSHOT_MAX_EXAMPLES=6
# Truncation per few-shot example, characters. Default: 600
SALES0_FEWSHOT_TEXT_CHARS=600
# Truncation of the enquiry text sent to the LLM, characters. Default: 4000
SALES0_TRIAGE_MAX_INPUT_CHARS=4000
# Concurrent Haiku triage calls, 1-8. Default: 4
SALES0_TRIAGE_CONCURRENCY=4

# --- Discovery storage ---
# Days the full text of a post the AI skipped is kept before the purge job drops it (then only its fingerprint
# and snippet stay). 0 = keep forever (so data can be re-structured later without re-scraping). Default: 0
SALES0_SEEN_RAW_RETENTION_DAYS=0
# Add the 60 suggested buyer-intent keywords once at startup. true | false. Default: true
SALES0_SEED_SUGGESTED_KEYWORDS=true

# --- Team / outreach (Phase 3) ---
# Encrypts every member's Gmail token in the database and signs the "acting as" cookie.
# Generate one: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset (dev only): sales0 generates a key once and keeps it at <data dir>/secret.key (a loud
# warning is logged). Losing/changing the key means every member must reconnect Gmail.
SALES0_SECRET_KEY=
# The first admin, created at startup if no team member with this email exists.
SALES0_ADMIN_EMAIL=admin@smalltech.in
SALES0_ADMIN_NAME=Admin
# Max emails one member may send per local day through sales0. Default: 40
SALES0_GMAIL_DAILY_SEND_CAP=40
# Max size of one uploaded deck PDF in bytes. Default: 10485760 (10 MB)
SALES0_DECK_MAX_BYTES=10485760
# Hosted only: Google Cloud Storage bucket for deck PDFs (required there). Locally leave empty: <data_dir>/decks/.
SALES0_ATTACHMENTS_BUCKET=
# Only when serving on a non-loopback host (https URL registered with your Google OAuth client).
# Locally leave empty: the OAuth redirect is built from the address you opened sales0 on.
SALES0_PUBLIC_BASE_URL=
# Extra Host names this server answers to once logins are enabled (comma separated, any port), on top of
# loopback, SALES0_HOST and the SALES0_PUBLIC_BASE_URL host. Any other Host header gets a 400 (DNS rebinding
# guard); in open mode (no logins) only loopback and SALES0_HOST are accepted. Example: crm.example.com,10.0.0.5
SALES0_ALLOWED_HOSTS=
# Secure flag on cookies: auto | true | false. auto = https request, or X-Forwarded-Proto=https from a
# SALES0_TRUSTED_PROXIES peer, or an https SALES0_PUBLIC_BASE_URL. Default: auto
SALES0_COOKIE_SECURE=auto
# TEST ONLY: also accept Host 'testserver' (Starlette TestClient). Never set on a server.
# SALES0_ALLOW_TESTSERVER_HOST=false
# Google OAuth endpoints (leave as is; only changed for tests or a proxy).
SALES0_GOOGLE_AUTH_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
SALES0_GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
SALES0_GOOGLE_USERINFO_ENDPOINT=https://openidconnect.googleapis.com/v1/userinfo
SALES0_GOOGLE_REVOKE_ENDPOINT=https://oauth2.googleapis.com/revoke
# TEST ONLY (ignored unless SALES0_LINKEDIN_MODE=fixture): let the research fetcher reach loopback/private hosts.
# SALES0_RESEARCH_ALLOW_PRIVATE_HOSTS=

# --- Google Sheet sync (read-only; the app never writes to Sheets) ---
SALES0_SHEET_SYNC_MINUTES=30           # 0 disables the interval scheduler
# Sheet sync is opt-in: with no id set, that sheet is not synced. Put the ids from the Sheets' URLs here.
# SALES0_SHEET_CLIENT_SOURCING_ID=
# SALES0_SHEET_METRICS_ID=
# SALES0_SHEET_TABS_JSON=[{"name":"Active Enquiries","kind":"enquiries","gid":"0"}]
# SALES0_SHEET_FETCH_TIMEOUT_S=20
# SALES0_SHEET_FETCH_RETRIES=3
# SALES0_SHEET_FETCH_MAX_BYTES=20000000

# --- Ops (Phase 4) ---
# Monthly AI spend cap in USD (0 = off). Over the cap, ALL LLM calls stop (triage leaves enquiries pending).
SALES0_MONTHLY_SPEND_CAP_USD=0
SALES0_SPEND_CAP_WARN_PCT=80
# In-process scheduler (nightly discovery window, daily digest, sheet sync, purge). Jobs are
# enabled per job on /schedule; discovery_run and sheet_sync start DISABLED.
SALES0_SCHEDULER_ENABLED=true
# Seconds between scheduler polls
SALES0_SCHEDULER_POLL_S=5
SALES0_SCHEDULER_WINDOW_START=01:00
SALES0_SCHEDULER_WINDOW_END=05:00
SALES0_SCHEDULER_DISCOVERY_MAX_RUNS_PER_DAY=1
SALES0_SCHEDULER_DIGEST_TIME=07:30
SALES0_SCHEDULER_PURGE_TIME=04:15
# Prospect watch: tracked profiles are visited for new posts (job `profile_watch` is disabled until enabled on /schedule).
SALES0_SCHEDULER_WATCH_TIME=05:30
SALES0_WATCH_MAX_PROFILES_PER_RUN=25
SALES0_WATCH_MIN_DAYS_BETWEEN_CHECKS=3
SALES0_WATCH_MAX_POSTS_PER_PROFILE=15
# profile visits / watch runs per LinkedIn account per day; scheduled start jitter in minutes (0 = exact time)
SALES0_WATCH_MAX_VISITS_PER_DAY=30
SALES0_WATCH_MAX_RUNS_PER_DAY=2
SALES0_WATCH_START_JITTER_MIN=30
SALES0_WATCH_PROFILE_PAUSE_MIN_S=20
SALES0_WATCH_PROFILE_PAUSE_MAX_S=60
# true = also visit due tracked profiles at the end of every discovery run
SALES0_WATCH_APPEND_TO_DISCOVERY=false
SALES0_PURGE_RETENTION_DAYS=90
SALES0_DIGEST_AI_SUMMARY=true

# --- Reply tracking (Phase 5: read-only Gmail polling of sent outreach) ---
# Minutes between reply polls. 0 = off. Default: 10
SALES0_REPLY_POLL_MINUTES=
# Only sent messages newer than this many days are polled. Default: 60
SALES0_REPLY_LOOKBACK_DAYS=
# Extra "Send as" addresses that are us (comma separated); their messages never count as replies.
SALES0_REPLY_OWN_ALIASES=
# Max threads fetched per member per poll cycle. Default: 300
SALES0_REPLY_MAX_THREADS_PER_POLL=

# --- CRM / login (Phase 2) ---
# Bootstrap password for the FIRST admin account (not a shared team login once users exist).
# Unset/empty = open mode (loopback only; a public SALES0_HOST is refused without it).
SALES0_APP_PASSWORD=
# Login cookie lifetime in days (1-90). Default: 14
SALES0_SESSION_DAYS=
# Failed logins per minute per client IP before a lockout, and the lockout in seconds. Defaults: 5 / 60
SALES0_LOGIN_MAX_ATTEMPTS=
SALES0_LOGIN_LOCKOUT_S=
# Follow-up reminder offsets in calendar days from the contact date. Defaults: 3 / 7 / 14
SALES0_FOLLOWUP_DAYS_1=
SALES0_FOLLOWUP_DAYS_2=
SALES0_FOLLOWUP_DAYS_FINAL=
# A lead with no timeline event for this many days is "stale" (digest). Default: 14
SALES0_STALE_LEAD_DAYS=
# Repeat-poster flag: this many enquiries from one author within this many days. Defaults: 3 / 60
SALES0_REPEAT_POSTER_MIN=
SALES0_REPEAT_POSTER_DAYS=
# List page size for contacts and the pipeline list. Default: 50
SALES0_CRM_PAGE_SIZE=

# --- Per-user accounts (Phase 5) ---
# "Remember me" login cookie lifetime in days (1-365). Default: 30
SALES0_SESSION_REMEMBER_DAYS=
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For / X-Forwarded-Proto are trusted. Default: none
# REQUIRED behind a reverse proxy: without it every visitor shares the proxy's address, i.e. ONE login-throttle
# bucket (one attacker can lock everyone out) and cookies are not marked Secure from X-Forwarded-Proto.
SALES0_TRUSTED_PROXIES=
# Hours an admin-issued set-password link is valid (1-168). Default: 24
SALES0_PASSWORD_RESET_TTL_H=
# Minimum user password length (8-128). Default: 10
SALES0_PASSWORD_MIN_LENGTH=

# --- LinkedIn accounts (Phase 5) ---
# Session backend for NEW LinkedIn accounts: folder (Chrome profile under the data dir) or db (encrypted
# storage state, for servers). The default local account stays a folder. Default: folder
SALES0_LINKEDIN_SESSION_BACKEND=

# --- Hosted deployment (Cloud Run + PostgreSQL; see docs/deploy.md) ---
# local (default) or hosted. Hosted: no scheduler/poller threads, no local-browser runs (a laptop `sales0 worker`
# scrapes), manual actions run inside the request. Refuses to boot in open mode or without the settings below.
SALES0_MODE=
# Bearer token shared by the hosted app and the laptop worker (>= 32 chars): openssl rand -base64 36
SALES0_WORKER_TOKEN=
# true = create the database if missing and run `alembic upgrade head` at boot (hosted single instance). Default: false
SALES0_AUTO_MIGRATE=
# Hosted: seconds a manual action works before it stops and says "more remaining, click again". Default: 240
SALES0_HOSTED_ACTION_BUDGET_S=
# Seconds without a heartbeat after which a worker's claimed run is considered lost. Default: 180
SALES0_WORKER_STALE_S=
# PostgreSQL as parts (hosted; the password comes from Secret Manager). When SALES0_DB_HOST is set it replaces
# SALES0_DATABASE_URL. Defaults: port 5432, name sales0, user sales0_app, sslmode prefer, pool 2 + 2 overflow, recycle 300 s
SALES0_DB_HOST=
SALES0_DB_PORT=
SALES0_DB_NAME=
SALES0_DB_USER=
SALES0_DB_PASSWORD=
SALES0_DB_SSLMODE=
SALES0_DB_POOL_SIZE=
SALES0_DB_MAX_OVERFLOW=
SALES0_DB_POOL_RECYCLE_S=

# --- Laptop worker (`uv run sales0 worker`; uses SALES0_WORKER_TOKEN above) ---
# The hosted app's base URL, e.g. https://sales0-xxxxxxxx-uc.a.run.app
SALES0_WORKER_SERVER_URL=
# Seconds between polls while idle / between heartbeats during a run / raw posts per upload. Defaults: 15 / 30 / 25
SALES0_WORKER_POLL_S=
SALES0_WORKER_HEARTBEAT_S=
SALES0_WORKER_UPLOAD_BATCH=
# Label shown on the hosted Setup page. Default: this machine's host name
SALES0_WORKER_NAME=
